# PostgreSQL
POSTGRES_USER=pguser
POSTGRES_DB=ente_db
POSTGRES_PASSWORD=changeme

# MinIO (S3-compatible object storage for photos/videos)
# MINIO_ROOT_USER must be at least 3 characters.
# MINIO_ROOT_PASSWORD must be at least 8 characters.
MINIO_ROOT_USER=minio-user-changeme
MINIO_ROOT_PASSWORD=changeme_min_8_chars

# These four values must also be entered into museum.yaml (db.password and
# s3.*.key / s3.*.secret) - see museum.yaml.example.
