# Museum (Ente's API server) configuration.
#
# Copy this file to museum.yaml and fill in the placeholders. Keep the
# db.password and s3.*.key / s3.*.secret values in sync with the matching
# variables in .env (POSTGRES_PASSWORD, MINIO_ROOT_USER, MINIO_ROOT_PASSWORD).
#
# Generate key/hash/jwt secrets with, e.g.:
#   openssl rand -base64 32   # key.encryption, jwt.secret
#   openssl rand -base64 64   # key.hash
#
# Reference: https://github.com/ente-io/ente/blob/main/server/configurations/local.yaml

db:
    host: postgres
    port: 5432
    name: ente_db
    user: pguser
    password: CHANGE_ME_SAME_AS_POSTGRES_PASSWORD

s3:
    # Using MinIO as a production store, reachable behind Traefik at
    # ente-s3.cloud-works.ch. Path-style URLs avoid needing wildcard DNS/TLS
    # for per-bucket subdomains.
    are_local_buckets: false
    use_path_style_urls: true
    # Note: these three key names (b2-eu-cen, wasabi-eu-central-2-v3,
    # scw-eu-fr-v3) are fixed by museum and do not need to refer to the
    # actual providers in their names - any S3-compatible storage works.
    b2-eu-cen:
        key: CHANGE_ME_SAME_AS_MINIO_ROOT_USER
        secret: CHANGE_ME_SAME_AS_MINIO_ROOT_PASSWORD
        endpoint: ente-s3.cloud-works.ch
        region: eu-central-2
        bucket: b2-eu-cen
    wasabi-eu-central-2-v3:
        key: CHANGE_ME_SAME_AS_MINIO_ROOT_USER
        secret: CHANGE_ME_SAME_AS_MINIO_ROOT_PASSWORD
        endpoint: ente-s3.cloud-works.ch
        region: eu-central-2
        bucket: wasabi-eu-central-2-v3
        compliance: false
    scw-eu-fr-v3:
        key: CHANGE_ME_SAME_AS_MINIO_ROOT_USER
        secret: CHANGE_ME_SAME_AS_MINIO_ROOT_PASSWORD
        endpoint: ente-s3.cloud-works.ch
        region: eu-central-2
        bucket: scw-eu-fr-v3

# Base endpoints for the web apps, used by museum to build public links.
apps:
    public-albums: https://ente-albums.cloud-works.ch

key:
    encryption: CHANGE_ME_RANDOM_32_BYTE_BASE64
    hash: CHANGE_ME_RANDOM_64_BYTE_BASE64

jwt:
    secret: CHANGE_ME_RANDOM_32_BYTE_BASE64
