# Museum (Ente's API server) configuration.
#
# Copy this file to museum.yaml and fill in the placeholders.
#
# Database is the shared Postgres instance from docker-postgis (service
# "db"). Create a scoped role + database for Ente there first (do not use
# docker-postgis's shared superuser directly - see its DATABASES.md):
#   cd ../docker-postgis
#   docker compose exec db psql -U docker -d gis -c "CREATE ROLE ente_db WITH LOGIN PASSWORD '<password>';"
#   docker compose exec db psql -U docker -d gis -c "CREATE DATABASE ente_db OWNER ente_db;"
#
# Object storage is the shared MinIO instance from docker-minio, not a
# container in this repo. Get s3.*.key / s3.*.secret from there (its
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD, unless you created a scoped access
# key - see its README), and create the three buckets below on it first:
#   docker exec -it minio mc alias set local http://localhost:9000 <user> <pass>
#   docker exec -it minio mc mb local/ente-b2-eu-cen
#   docker exec -it minio mc mb local/ente-wasabi-eu-central-2-v3
#   docker exec -it minio mc mb local/ente-scw-eu-fr-v3
#
# Generate key/hash/jwt secrets with, e.g.:
#   openssl rand -base64 32   # key.encryption, jwt.secret
#   openssl rand -base64 64   # key.hash
#
# Reference: https://github.com/ente-io/ente/blob/main/server/configurations/local.yaml

db:
    host: db
    port: 5432
    name: ente_db
    # The scoped role created above, not docker-postgis's shared superuser.
    user: ente_db
    password: CHANGE_ME_SAME_AS_ROLE_PASSWORD_ABOVE

s3:
    # docker-minio is reachable behind Traefik at s3.cloud-works.ch. Path-style
    # URLs avoid needing wildcard DNS/TLS for per-bucket subdomains.
    are_local_buckets: false
    use_path_style_urls: true
    # Note: these three key names (b2-eu-cen, wasabi-eu-central-2-v3,
    # scw-eu-fr-v3) are fixed by museum and do not need to refer to the
    # actual providers in their names - any S3-compatible storage works. The
    # "bucket:" values are prefixed with ente- since docker-minio's bucket
    # namespace is shared across apps.
    b2-eu-cen:
        key: CHANGE_ME_MINIO_ACCESS_KEY
        secret: CHANGE_ME_MINIO_SECRET_KEY
        endpoint: s3.cloud-works.ch
        region: eu-central-2
        bucket: ente-b2-eu-cen
    wasabi-eu-central-2-v3:
        key: CHANGE_ME_MINIO_ACCESS_KEY
        secret: CHANGE_ME_MINIO_SECRET_KEY
        endpoint: s3.cloud-works.ch
        region: eu-central-2
        bucket: ente-wasabi-eu-central-2-v3
        compliance: false
    scw-eu-fr-v3:
        key: CHANGE_ME_MINIO_ACCESS_KEY
        secret: CHANGE_ME_MINIO_SECRET_KEY
        endpoint: s3.cloud-works.ch
        region: eu-central-2
        bucket: ente-scw-eu-fr-v3

# Base endpoints for the web apps, used by museum to build public links.
apps:
    public-albums: https://ente-albums.cloud-works.ch

key:
    encryption: CHANGE_ME_RANDOM_32_BYTE_BASE64
    hash: CHANGE_ME_RANDOM_64_BYTE_BASE64

jwt:
    secret: CHANGE_ME_RANDOM_32_BYTE_BASE64
